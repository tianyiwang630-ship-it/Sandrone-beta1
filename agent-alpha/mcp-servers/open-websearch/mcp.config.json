{
  "enabled": true,
  "type": "stdio",
  "command": "cmd",
  "args": ["/c", "npx", "-y", "open-websearch@latest"],
  "env": {
    "DEFAULT_SEARCH_ENGINE": "duckduckgo",
    "ALLOWED_SEARCH_ENGINES": "bing,baidu,csdn,duckduckgo,juejin,sogou",
    "MODE": "stdio",
    "SYSTEMROOT": "C:/Windows"
  },
  "description": "Official open-websearch MCP startup via npx. Enabled engines: bing, baidu, csdn, duckduckgo, juejin, sogou."
}
